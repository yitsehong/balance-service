# ---- Build jar (JVM) ----
FROM gradle:9-jdk25 AS jvm-build

WORKDIR /workspace

COPY gradlew gradlew.bat settings.gradle* build.gradle* ./
COPY gradle/wrapper ./gradle/wrapper
RUN chmod +x gradlew
COPY src ./src

# Build normal Spring Boot JAR
RUN ./gradlew bootJar --no-daemon

# ---- Runtime JVM Image ----
FROM amazoncorretto:25 AS jvm-runtime

WORKDIR /app

# Copy the built jar from previous stage
COPY --from=jvm-build /workspace/build/libs/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]

